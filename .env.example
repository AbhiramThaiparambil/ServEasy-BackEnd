# ServEasy Backend - Environment Variables Example
# --- Server Configuration ---
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database & In-Memory Cache ---
MONGOURL=mongodb://localhost:27017/serveasy
REDIS_URL=redis://127.0.0.1:6379

# --- JWT Authentication Secrets ---
ACCESS_TOKEN_SECRET=your_jwt_access_secret_key_here
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_key_here

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# --- Google Gemini AI API ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Razorpay Payment Gateway ---
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpayKeySecretHere

# --- Cloudinary Media Storage ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- LocationIQ API (Geocoding & Autocomplete) ---
LOCATIONIQ_API_KEY=your_locationiq_api_key_here

# --- Email Service (Nodemailer SMTP) ---
EMAIL_SERVICE_HOST=smtp.gmail.com
EMAIL_SERVICE_PORT=587
EMAIL_SERVICE_SECURE=false
EMAIL_SERVICE_EMAIL=your_email@gmail.com
EMAIL_SERVICE_PASSWORD=your_email_app_password_here

# --- SMS Service (Twilio) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
